<section class="hand-section" aria-label="Player hand">
    <div class="hand-heading">
        <div>
            <MudText Typo="Typo.h6" Class="section-title">@GameState.CurrentPlayer.Name's hand</MudText>
            <MudText Typo="Typo.body2" Class="hand-count">@GameState.CurrentPlayer.Hand.Count cards available</MudText>
        </div>
        <div class="deck-status" aria-label="@($"{GameState.Deck.Cards.Count} cards in deck; {GameState.RequiredCardsToPlay} required to play")">
            <span class="deck-status-value">@GameState.Deck.Cards.Count</span>
            <span class="deck-status-label">in deck</span>
            <span class="deck-status-divider" aria-hidden="true"></span>
            <span class="deck-status-value">@GameState.RequiredCardsToPlay</span>
            <span class="deck-status-label">to play</span>
        </div>
    </div>
    <div class="card-hand" role="group" aria-label="Choose a card">
        @foreach (var card in GameState.CurrentPlayer.Hand)
        {
            <MudButton OnClick="@(() => OnCardSelected(card))"
                       Disabled="@(SelectCard != null || GameState.IsGameOver)"
                       Variant="Variant.Filled" Class="game-card"
                       aria-label="@($"Select card {card.ValueCard}")">
                @card.ValueCard
            </MudButton>
        }
    </div>
</section>

@code {
    [Parameter]
    public GameState GameState { get; set; }

    [Parameter]
    public EventCallback<GameState> GameStateChanged { get; set; }


    [Parameter]
    public Card SelectCard { get; set; }

    [Parameter]
    public EventCallback<Card> SelectCardChanged { get; set; }

    private void OnCardSelected(Card card)
    {
        if (SelectCard == null)
        {
            SelectCard = card;
        }
        SelectCardChanged.InvokeAsync(SelectCard);
        GameStateChanged.InvokeAsync(GameState);
    }

}
