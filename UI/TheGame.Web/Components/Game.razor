@using Domain
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudContainer>
    <MudPaper>
        <TargetPiles GameState="@GameState" IsDisabled="@(Move.Card is null || GameState.IsGameOver)"
                     @bind-SelectedPile="Move.TargetPile" @bind-SelectedPile:after="OnPileSelected" />
        <ValidationResultDisplay Validation="@Validation" />
        <MudDivider Class="mb-3" />

        <PlayerCards @bind-GameState="@GameState" @bind-SelectCard="@Move.Card" />

        <MudStack AlignItems="AlignItems.Center">
            <MudButtonGroup Color="Color.Info">
                <MudButton OnClick="@NextTurn" Disabled="@((Move.Card != null) || GameState.IsGameOver)">
                    Next Turn
                </MudButton>
                <MudButton OnClick="@(() => Move = new Move())"
                           Disabled="@((Move.Card == null) || GameState.IsGameOver)">
                    Select different card
                </MudButton>
            </MudButtonGroup>
        </MudStack>

        
        @if (GameState.IsGameOver)
        {
            <MudAlert Severity="Severity.Error">Game over. No valid moves left.</MudAlert>
        }

    </MudPaper>
</MudContainer>
@code {
    GameState GameState { get; set; } = new();
    GameEngine GameEngine { get; set; } = new GameEngine(new MoveService());

    Move Move { get; set; } = new();
    ValidationResult? Validation { get; set; }


    protected override void OnInitialized()
    {
        GameEngine.StartGame(
            GameState,
            [new Player { Name = "Player 1", IsAi = false }]);
    }
    private void OnPileSelected()
    {
     
        Validation = GameEngine.ValidateMove(Move);
        if (!Validation.IsValid)
        {
            GameState.IsGameOver = !GameEngine.HasValidMove(GameState);
            Move = new Move();
            return;
        }
    
        GameEngine.ApplyMove(GameState, Move);
     
    }
    private void NextTurn()
    {
        Validation = GameEngine.EndTurn(GameState);
        if (Validation.IsValid)
        {
            GameEngine.StartTurn(GameState);
        }
        GameState.IsGameOver = !GameEngine.HasValidMove(GameState);
    }

}
