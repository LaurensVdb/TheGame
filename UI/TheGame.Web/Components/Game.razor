@using Domain
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudContainer MaxWidth="MaxWidth.Large" Class="game-shell">
    <MudPaper Elevation="0" Class="game-panel">
        <header class="game-header">
            <div>
                <p class="game-eyebrow">A game of focus &amp; foresight</p>
                <MudText Typo="Typo.h1" Class="game-title">The Game</MudText>
                <p class="game-subtitle">Play your cards. Find your rhythm. Keep the deck moving.</p>
            </div>
        </header>

        <TargetPiles GameState="@GameState" IsDisabled="@(Move.Card is null || GameState.IsGameOver)"
                     @bind-SelectedPile="Move.TargetPile" @bind-SelectedPile:after="OnPileSelected" />

        <MudDivider Class="game-divider" />

        <PlayerCards @bind-GameState="@GameState" @bind-SelectCard="@Move.Card" />

        <ValidationResultDisplay Validation="@Validation" />

        <footer class="game-actions">
            <MudButton OnClick="@NextTurn" Disabled="@((Move.Card != null) || GameState.IsGameOver)"
                       Variant="Variant.Filled" Color="Color.Primary" Class="game-action-primary">
                End turn
            </MudButton>
            <MudButton OnClick="@(() => Move = new Move())" Disabled="@((Move.Card == null) || GameState.IsGameOver)"
                       Variant="Variant.Outlined" Color="Color.Inherit" Class="game-action-secondary">
                Choose another card
            </MudButton>
        </footer>

        @if (GameState.IsGameWon)
        {
            <MudAlert Severity="Severity.Success" Class="game-win-alert">
                <strong>Well played.</strong> You have won the game!
            </MudAlert>
        }
    </MudPaper>
</MudContainer>
@code {
    GameState GameState { get; set; } = new();
    GameEngine GameEngine { get; set; } = new GameEngine(new MoveService());

    Move Move { get; set; } = new();
    ValidationResult? Validation { get; set; }


    protected override void OnInitialized()
    {
        GameEngine.StartGame(
            GameState,
            [new Player { Name = "Player 1", IsAi = false }]);
    }
    private void OnPileSelected()
    {
     
        Validation = GameEngine.ValidateMove(Move);
        if (!Validation.IsValid)
        {
            return;
        }
       
        GameEngine.ApplyMove(GameState, Move);
        Move = new Move();
     
    }
    private void NextTurn()
    {
        Validation = GameEngine.EndTurn(GameState);
        if (Validation.IsValid)
        {
            GameEngine.StartTurn(GameState);
        }
        CheckIfGameIsOver();
        Move = new Move();
    }

    private void CheckIfGameIsOver()
    {
        GameState.IsGameOver = !GameEngine.HasValidMove(GameState);
    
        if (GameState.IsGameOver)
        {
            Validation = new ValidationResult(
                false,
                "Game over. No valid moves left.");
        }
       
    }

}
